# Supabase 프로젝트의 공개 연결 정보입니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Vercel 같은 서버리스 런타임은 Transaction Pooler(6543)를 사용합니다.
DATABASE_URL=

# 마이그레이션은 Session Pooler(5432) 또는 Direct URL을 사용합니다.
DIRECT_URL=

# 휴대전화가 접근할 수 있는 주소 또는 배포 URL입니다.
PUBLIC_BASE_URL=http://192.168.0.15:8000

# DATABASE_URL이 비어 있을 때만 사용하는 SQLite 경로입니다.
LIVEPULSE_DB=./data/livepulse.db
